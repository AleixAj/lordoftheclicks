# Copy this file to `.env.local` and fill in the values you need.
# Variables MUST be prefixed with `VITE_` to be exposed to the client.

# Shown somewhere in the UI as a build identifier.
VITE_APP_VERSION=0.1.0

# Optional: Sentry DSN to start reporting client errors.
# VITE_SENTRY_DSN=

# Optional: CDN base URL for static assets (sprites, sounds, backgrounds).
# Leave empty to serve from /public.
# VITE_ASSETS_BASE_URL=
